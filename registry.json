[
  {
    "id": "hacker-news",
    "version": 1,
    "matches": ["https://news.ycombinator.com/*"],
    "description": "Hacker News front page and comment threads"
  },
  {
    "id": "reddit",
    "version": 6,
    "matches": [
      "https://www.reddit.com/*",
      "https://old.reddit.com/*",
      "https://reddit.com/*",
      "https://m.reddit.com/*"
    ],
    "description": "Reddit posts with scores and comments (uses your login via background tab)"
  },
  {
    "id": "gmail",
    "version": 1,
    "matches": ["https://mail.google.com/*"],
    "description": "Gmail views: inbox, labels, and search (uses your login via background tab)"
  },
  {
    "id": "x",
    "version": 1,
    "matches": ["https://x.com/*", "https://twitter.com/*"],
    "description": "X timeline posts with replies (uses your login via background tab)"
  },
  {
    "id": "youtube",
    "version": 1,
    "matches": [
      "https://www.youtube.com/watch*",
      "https://www.youtube.com/@*",
      "https://www.youtube.com/channel/*",
      "https://www.youtube.com/c/*",
      "https://www.youtube.com/user/*",
      "https://www.youtube.com/results*",
      "https://m.youtube.com/watch*",
      "https://youtu.be/*"
    ],
    "description": "YouTube videos and channel listings"
  },
  {
    "id": "generic-article",
    "version": 1,
    "matches": ["https://*/*", "http://*/*"],
    "description": "Fallback article extraction"
  },
  {
    "id": "reuters",
    "version": 1,
    "matches": ["https://www.reuters.com/*", "https://reuters.com/*"],
    "description": "Reuters global news"
  },
  {
    "id": "apnews",
    "version": 1,
    "matches": ["https://apnews.com/*", "https://www.apnews.com/*"],
    "description": "AP News articles"
  },
  {
    "id": "bbc",
    "version": 1,
    "matches": ["https://www.bbc.com/*", "https://www.bbc.co.uk/*"],
    "description": "BBC world news"
  },
  {
    "id": "nytimes",
    "version": 1,
    "matches": ["https://www.nytimes.com/*", "https://nytimes.com/*"],
    "description": "New York Times news and features"
  },
  {
    "id": "theguardian",
    "version": 1,
    "matches": ["https://www.theguardian.com/*"],
    "description": "The Guardian news and opinion"
  },
  {
    "id": "npr",
    "version": 1,
    "matches": ["https://www.npr.org/*", "https://npr.org/*"],
    "description": "NPR news and audio"
  },
  {
    "id": "cnn",
    "version": 1,
    "matches": ["https://www.cnn.com/*", "https://cnn.com/*"],
    "description": "CNN news"
  },
  {
    "id": "washingtonpost",
    "version": 1,
    "matches": ["https://www.washingtonpost.com/*"],
    "description": "Washington Post news"
  },
  {
    "id": "theatlantic",
    "version": 1,
    "matches": ["https://www.theatlantic.com/*"],
    "description": "The Atlantic long-form journalism"
  },
  {
    "id": "economist",
    "version": 1,
    "matches": ["https://www.economist.com/*"],
    "description": "Economist global affairs"
  },
  {
    "id": "google-news",
    "version": 1,
    "matches": ["https://news.google.com/*"],
    "description": "Google News aggregation"
  }
]
