{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Digest recipe",
  "description": "Declarative extraction recipe. Selectors may change; field and action names are a frozen contract (see AGENTS.md).",
  "type": "object",
  "required": ["id", "version", "matches", "content"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9-]+$" },
    "version": { "type": "integer", "minimum": 1 },
    "matches": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^https?://[^\\s]+$" }
    },
    "description": { "type": "string" },
    "icon": { "type": "string" },
    "fetchMode": { "type": "string", "enum": ["dom", "tab-json", "tab-dom"] },
    "content": {
      "type": "object",
      "required": ["item"],
      "additionalProperties": false,
      "properties": {
        "item": { "type": "string", "minLength": 1 },
        "id": { "$ref": "#/definitions/field" },
        "title": { "$ref": "#/definitions/field" },
        "url": { "$ref": "#/definitions/field" },
        "author": { "$ref": "#/definitions/field" },
        "timestamp": { "$ref": "#/definitions/field" },
        "body": { "$ref": "#/definitions/field" },
        "image": { "$ref": "#/definitions/field" }
      }
    },
    "comments": {
      "type": "object",
      "required": ["container"],
      "additionalProperties": false,
      "properties": {
        "container": { "type": "string", "minLength": 1 },
        "author": { "$ref": "#/definitions/field" },
        "body": { "$ref": "#/definitions/field" },
        "timestamp": { "$ref": "#/definitions/field" }
      }
    },
    "actions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["selector"],
        "additionalProperties": false,
        "properties": { "selector": { "type": "string", "minLength": 1 } }
      }
    }
  },
  "definitions": {
    "field": {
      "anyOf": [
        { "type": "string" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "selector": { "type": "string" },
            "attribute": { "type": "string" },
            "value": { "type": "string" }
          }
        }
      ]
    }
  }
}
